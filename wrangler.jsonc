{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "embeddings",
  "account_id": "213ab3604485056376263d22fa242742",
  "compatibility_date": "2026-10-13",
  // Preserve the approved apex attachment in every generated production deployment.
  "routes": [
    {
      "pattern": "embeddings.au",
      "custom_domain": true,
      "zone_id": "9148c362fcb1400590f7a5eb923f75fc"
    }
  ],
  "main": "src/worker.ts",
  "vars": {
    "CONTACT_MODE": "production"
  },
  "secrets": {
    "required": [
      "RESEND_API_KEY",
      "CONTACT_TO_EMAIL",
      "TURNSTILE_SECRET_KEY"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/*.avif",
      "!/*.css",
      "!/*.gif",
      "!/*.ico",
      "!/*.jpg",
      "!/*.jpeg",
      "!/*.js",
      "!/*.json",
      "!/*.map",
      "!/*.mjs",
      "!/*.pdf",
      "!/*.png",
      "!/*.svg",
      "!/*.txt",
      "!/*.webmanifest",
      "!/*.webp",
      "!/*.woff",
      "!/*.woff2",
      "!/*.xml"
    ]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
