{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Astro: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "(?:Local:?|Dev server running at)\\s+(https?://[^\\s\"\\\\]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Astro: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3002",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Astro: debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "(?:Local:?|Dev server running at)\\s+(https?://[^\\s\"\\\\]+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    }
  ]
}
