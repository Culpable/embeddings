---
import ShoppaMark from '@/components/site/ShoppaMark.astro'

const shoppaColours = {
  canvas: '#fff4e9',
  ink: '#3b2416',
  inkSoft: '#6b4a31',
  accent: '#d6552b',
  border: '#f0dec8',
}

const shoppaUrl = 'https://shoppa.au/'
---
<div class="mt-10 flex flex-col gap-6 rounded-3xl p-8 ring-1 sm:flex-row sm:items-center sm:p-10" style={{
        backgroundColor: shoppaColours.canvas,
        color: shoppaColours.ink,
        '--tw-ring-color': shoppaColours.border,
      }}>
      <ShoppaMark className="h-14 w-14 flex-none" />
      <div class="flex-1">
        <h3 class="font-display text-2xl font-medium tracking-tight">
          Prefer a ready-made shopping agent?
        </h3>
        <p class="mt-2 text-base" style={{ color: shoppaColours.inkSoft }}>
          shoppa is a packaged AI shopping agent for retailers. Choose it if you
          want a product rather than a custom build.
        </p>
      </div>
      <a href={shoppaUrl} target="_blank" rel="noreferrer" class="inline-flex min-h-11 w-fit flex-none items-center gap-1.5 rounded-full px-5 py-2 text-sm font-semibold text-white transition-[transform,filter] duration-200 ease-out hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-950 focus-visible:ring-offset-2 active:scale-[0.96]" style={{ backgroundColor: shoppaColours.accent }}>
        <span class="relative top-px">Visit shoppa.au</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
