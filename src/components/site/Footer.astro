---
import Container from '@/components/site/Container.astro'

import FadeIn from '@/components/site/FadeIn.astro'

import Logo from '@/components/site/Logo.astro'

import Offices from '@/components/site/Offices.astro'

import Navigation from '@/components/site/Navigation.astro'
---
<Container as="footer" className="mt-24 w-full sm:mt-32 lg:mt-40">
      <FadeIn>
        <div class="grid grid-cols-1 gap-x-8 gap-y-16 lg:grid-cols-2">
          <Navigation />
          <div class="flex lg:justify-end">
            <div class="max-w-sm">
              <h2 class="font-display text-base font-semibold text-neutral-950">
                our offices
              </h2>
              <Offices className="mt-6 grid grid-cols-1 gap-8 sm:grid-cols-2" />
            </div>
          </div>
        </div>
        <div class="mb-20 mt-24 flex flex-wrap items-end justify-between gap-x-6 gap-y-4 border-t border-neutral-950/10 pt-12">
          <a href="/" aria-label="Home" class="inline-flex min-h-11 min-w-11 items-center sm:min-h-10 sm:min-w-10">
            <Logo className="h-8" fillOnHover />
          </a>
          <p class="text-sm text-neutral-700">
            © embeddings {new Date().getFullYear()}
          </p>
        </div>
      </FadeIn>
    </Container>
