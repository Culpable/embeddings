<div class="surface-elevation-dark rounded-3xl bg-white/[0.04] p-5 sm:p-6">
      <p class="font-display text-xs font-semibold uppercase tracking-widest text-white/50">
        your controls
      </p>


      <div class="mt-5 rounded-2xl border border-white/10 bg-neutral-950 p-4">
        <p class="text-[0.65rem] font-semibold uppercase tracking-widest text-white/60">
          tone rule
        </p>
        <p class="mt-2 font-mono text-xs leading-6 text-white/85">
          Always offer the in-store pickup option.

          <span class="agent-caret ml-0.5 inline-block h-[1em] w-px bg-emerald-300 align-[-0.15em]" />
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-2">

          <span class="relative inline-flex h-7 items-center rounded-full bg-white px-3 text-xs font-semibold text-neutral-950" aria-hidden="true">
            <span class="agent-publish-label">Publish</span>
            <span class="agent-live-label absolute inset-0 inline-flex items-center justify-center gap-1.5 rounded-full bg-emerald-400 text-neutral-950">
              <span class="h-1.5 w-1.5 rounded-full bg-neutral-950" />
