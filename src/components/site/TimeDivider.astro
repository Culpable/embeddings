---
import Reveal from '@/components/site/Reveal.astro'

const { delay } = Astro.props
---
<Reveal delay={delay} className="flex items-center gap-3">
      <span class="h-px flex-1 bg-neutral-950/10" aria-hidden="true" />
      <p class="rounded-full bg-neutral-100 px-3 py-1 text-[0.65rem] font-semibold text-neutral-600 ring-1 ring-inset ring-neutral-950/10">
        <slot />
      </p>
      <span class="h-px flex-1 bg-neutral-950/10" aria-hidden="true" />
    </Reveal>
