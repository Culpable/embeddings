---
import NoiseOverlay from '@/components/site/NoiseOverlay.astro'

import Reveal from '@/components/site/Reveal.astro'

import ConversationStoryboard from '@/components/site/ConversationStoryboard.astro'

import ControlStrip from '@/components/site/ControlStrip.astro'

import AnalyticsTiles from '@/components/site/AnalyticsTiles.astro'

const capabilityChips = [
  { short: 'discovery', full: 'conversational discovery' },
  { short: 'in-chat checkout', full: 'checkout in the chat' },
  { short: 'order support', full: 'order & returns support' },
  { short: 'your own search', full: 'bring your own search' },
  { short: 'self-service', full: 'self-service control' },
  { short: 'analytics', full: 'revenue analytics' },
]

const CONVERSATION_BEAT_COUNT = 7

const BEAT_STEP_MS = 260

const TRAILING_STEP_MS = 160

function trailingDelay(index: number) {
  // Return the reveal delay for the nth element after the conversation.
  return CONVERSATION_BEAT_COUNT * BEAT_STEP_MS + index * TRAILING_STEP_MS
}
---
<div class="relative overflow-hidden rounded-4xl bg-neutral-950 px-5 py-10 sm:px-10 sm:py-14">
      <NoiseOverlay id="agent-showcase" />


      <div class="relative grid grid-cols-1 gap-6 lg:grid-cols-[1.15fr_1fr] lg:items-start">

        <ConversationStoryboard />

        <div class="grid grid-cols-1 gap-6">
          <Reveal delay={trailingDelay(0)}>
            <ControlStrip />
          </Reveal>
          <Reveal delay={trailingDelay(1)}>
            <AnalyticsTiles />
          </Reveal>
        </div>
      </div>


      <Reveal delay={trailingDelay(2)}>
        <ul role="list" class="relative mt-8 flex flex-wrap gap-2" aria-label="What your agent does">
          {capabilityChips.map(({ short, full }) => (
            <li class="rounded-full border border-white/15 bg-white/[0.04] px-2.5 py-1 text-[11px] font-medium text-white/70 sm:px-3 sm:py-1.5 sm:text-xs">

              <span class="sm:hidden">{short}</span>
              <span class="hidden sm:inline">{full}</span>
            </li>
          ))}
        </ul>
      </Reveal>
    </div>
