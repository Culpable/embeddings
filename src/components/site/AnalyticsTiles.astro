---
const analyticsTiles = [
  { label: 'sessions', value: '1,284' },
  { label: 'conversion', value: '4.8%' },
  { label: 'assisted revenue', value: '$42k' },
]
---
<div class="surface-elevation-dark rounded-3xl bg-white/[0.04] p-5 sm:p-6">
      <div class="flex items-center justify-between gap-3">
        <p class="font-display text-xs font-semibold uppercase tracking-widest text-white/50">
          your reporting
        </p>
        <span class="rounded-full border border-white/15 px-2 py-0.5 text-[0.6rem] font-medium uppercase tracking-widest text-white/60">
          sample
        </span>
      </div>


      <dl class="mt-5 grid grid-cols-3 gap-2">
        {analyticsTiles.map(({ label, value }) => (
          <div class="flex flex-col-reverse justify-end rounded-2xl border border-white/10 bg-neutral-950 px-3 py-3">

            <dt class="mt-1 text-xs leading-4 text-white/70">
              {label}
            </dt>
            <dd class="font-display text-base font-semibold tracking-tight text-white sm:text-lg">
              {value}
            </dd>
          </div>
        ))}
      </dl>


      <p class="mt-5 font-display text-lg font-medium tracking-tight text-white sm:text-xl">
        Reporting your team can act on.
      </p>


      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="rounded-full border border-white/15 px-2.5 py-1 text-xs text-white/70">
          drop-off: delivery questions
        </span>
        <span class="text-xs text-white/50" aria-hidden="true">
          →
        </span>
        <span class="rounded-full border border-white/15 px-2.5 py-1 text-xs text-emerald-300">
          reply updated · live
        </span>
        <span class="sr-only">
          Example insight: customers drop off at delivery questions, and the
          corrected reply is already live.
        </span>
      </div>
    </div>
