---
import Check from '@/components/site/IconCheck.astro'

import FileText from '@/components/site/IconFileText.astro'

const conversation = {
  label: 'Assistant',
  question: 'What needs my attention before Friday?',
  answer:
    'Three things. Two invoices are more than 30 days overdue, the supplier contract renews on Thursday, and four customer emails have waited over two days for a reply.',
  sources: ['Accounts', 'Contracts', 'Shared inbox'],
  actions: [
    'Payment reminders drafted in Accounts',
    'Four replies drafted in the shared inbox',
  ],
}

const answerDelayMs = 900

const firstActionDelayMs = 1800

const actionStepMs = 600
---
<div class="surface-elevation-light overflow-hidden rounded-3xl bg-white">
      <div class="border-b border-neutral-950/5 px-5 py-3">
        <p class="text-sm font-semibold text-neutral-950">
          {conversation.label}
        </p>
      </div>
      <div class="space-y-4 bg-neutral-50/60 p-5">

        <p class="agent-beat ml-auto max-w-[85%] rounded-2xl rounded-br-md bg-neutral-950 px-4 py-3 text-sm text-white">
          {conversation.question}
        </p>


        <div class="agent-beat max-w-[92%] rounded-2xl rounded-bl-md bg-white px-4 py-3 text-sm text-neutral-700 ring-1 ring-neutral-950/5" style={{ '--agent-beat-delay': `${answerDelayMs}ms` }}>
          <p>{conversation.answer}</p>
          <ul role="list" class="mt-3 flex flex-wrap gap-1.5" aria-label="Sources">
            {conversation.sources.map((source) => (
              <li class="inline-flex items-center gap-1 rounded-full bg-neutral-100 px-2.5 py-1 text-xs font-medium text-neutral-600">
                <FileText className="h-3 w-3" aria-hidden="true" />
                {source}
              </li>
            ))}
          </ul>
        </div>


        <ul role="list" class="space-y-4" aria-label="Completed actions">
          {conversation.actions.map((action, index) => (
            <li class="agent-beat flex items-center gap-2 rounded-xl border border-dashed border-neutral-300 bg-white px-3 py-2 text-xs font-semibold text-neutral-700" style={{
                '--agent-beat-delay': `${firstActionDelayMs + index * actionStepMs}ms`,
              }}>
              <span class="flex h-5 w-5 flex-none items-center justify-center rounded-full bg-emerald-500 text-white">
                <Check className="h-3 w-3" aria-hidden="true" />
              </span>
              {action}
            </li>
          ))}
        </ul>
      </div>
    </div>
