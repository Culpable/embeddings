---
import Container from '@/components/site/Container.astro'

import FadeIn from '@/components/site/FadeIn.astro'

import FadeInStagger from '@/components/site/FadeInStagger.astro'

import SectionIntro from '@/components/site/SectionIntro.astro'

const capabilities = [
  {
    index: '01',
    title: 'Agent & LLM Pipeline Engineering',
    body: 'We build assistants, agents and the pipelines behind them: grounding answers in your own documents and data, connecting them to the software your teams use, and processing information at scale.',
  },
  {
    index: '02',
    title: 'Data Infrastructure',
    body: 'We integrate directly with your ERP, CRM, document systems and custom software, so AI works from current, accurate data rather than stale copies.',
  },
  {
    index: '03',
    title: 'E-commerce Expertise',
    body: 'For retailers, we bring product data and search experience, including Google Merchant Centre specifications, GTIN standards and product taxonomy.',
  },
]
---
<div class="mt-24 rounded-4xl bg-neutral-950 py-24 sm:mt-32 lg:mt-40 lg:py-32">
      <SectionIntro eyebrow="our expertise" title="Deep technical skill, applied to everyday work" invert>
        <p>
          We combine deep technical knowledge with hands-on delivery, across
          teams and industries. Whatever the problem, we start with your data
          and systems, build something your team will use, and keep improving
          it after launch.
        </p>
      </SectionIntro>
      <Container className="mt-16">
        <FadeInStagger>
          <ul role="list" class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
            {capabilities.map(({ index, title, body }) => (
              <li class="text-neutral-300">
                <FadeIn>
                  <div class="relative pl-8">

                    <div class="absolute left-0 top-0 h-6 w-px bg-white" aria-hidden="true" />
                    <div class="absolute bottom-0 left-0 top-8 w-px bg-white/10" aria-hidden="true" />


                    <span class="block font-display text-sm font-semibold tracking-widest text-white/50">
                      {index}
                    </span>


                    <strong class="mt-4 block font-display text-lg font-semibold tracking-tight text-white">
                      {title}.
                    </strong>


                    <p class="mt-3 text-base leading-7 text-neutral-400">
                      {body}
                    </p>
                  </div>
                </FadeIn>
              </li>
            ))}
          </ul>
        </FadeInStagger>
      </Container>
    </div>
