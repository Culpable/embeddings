---
import clsx from 'clsx'

import Border from '@/components/site/Border.astro'

import FadeIn from '@/components/site/FadeIn.astro'

const { title, className, invert = false } = Astro.props
---
<li class={clsx(
        'text-base',
        invert
          ? 'text-neutral-300 before:bg-white after:bg-white/10'
          : 'text-neutral-600 before:bg-neutral-950 after:bg-neutral-100',
        className,
      )}>
      <FadeIn>
        <Border position="left" className="pl-8" invert={invert}>
          <strong class={clsx(
              'font-semibold',
              invert ? 'text-white' : 'text-neutral-950',
            )}>
            {title}.
          </strong>{' '}
          <slot />
        </Border>
      </FadeIn>
    </li>
