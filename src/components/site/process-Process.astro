---
import ContactSection from '@/components/site/ContactSection.astro'

import PageIntro from '@/components/site/PageIntro.astro'

import Discover from '@/components/site/process-Discover.astro'

import Build from '@/components/site/process-Build.astro'

import Deploy from '@/components/site/process-Deploy.astro'

import Operate from '@/components/site/process-Operate.astro'

import Values from '@/components/site/process-Values.astro'
---


      <PageIntro eyebrow="our process" title="How we work">
        <p>
          We take a systematic approach to AI implementation, so each system
          delivers value early and gives you a foundation to build on.
        </p>
      </PageIntro>

      <div class="mt-24 space-y-24 [counter-reset:section] sm:mt-32 sm:space-y-32 lg:mt-40 lg:space-y-40">
        <Discover />
        <Build />
        <Deploy />
        <Operate />
      </div>

      <Values />

      <ContactSection />
