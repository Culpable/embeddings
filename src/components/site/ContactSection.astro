---
import Button from '@/components/site/Button.astro'

import Container from '@/components/site/Container.astro'

import FadeIn from '@/components/site/FadeIn.astro'
---
<Container className="mt-24 sm:mt-32 lg:mt-40">
      <FadeIn>
        <div class="grid gap-10 rounded-4xl bg-neutral-100 px-6 py-16 sm:px-12 sm:py-20 lg:grid-cols-[1.4fr_1fr] lg:items-end">
          <h2 class="font-display text-4xl font-medium tracking-tight text-neutral-950 [text-wrap:balance] sm:text-5xl">
            Where could AI take work off your team?
          </h2>
          <div>
            <p class="text-lg text-neutral-600">
              Tell us how your team works today. We’ll come back with a
              practical first step.
            </p>
            <Button href="/contact/" className="mt-6">
              Contact us
            </Button>
          </div>
        </div>
      </FadeIn>
    </Container>
