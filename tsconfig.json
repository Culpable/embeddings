{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*.astro",
    "src/**/*.ts",
    "worker-configuration.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "dist",
    ".astro-server",
    "src/app",
    "videos",
    "node_modules"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  }
}
